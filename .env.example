# Copy to .env for local Docker Compose overrides.

TZ=Asia/Shanghai
SPRING_PROFILES_ACTIVE=prod

MYSQL_HOST_PORT=13306
MYSQL_DATABASE=blog_cloud
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_APP_USERNAME=blog_cloud
MYSQL_APP_PASSWORD=change-app-password

REDIS_PASSWORD=

RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=blog_cloud
RABBITMQ_DEFAULT_PASS=change-rabbitmq-password

NACOS_PUBLIC_PORT=8848
NACOS_AUTH_ENABLE=true
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=blog-cloud
NACOS_AUTH_TOKEN=change-this-to-a-long-random-string-at-least-32-chars
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_CONFIG_GROUP=BLOG_CLOUD
NACOS_DISCOVERY_GROUP=BLOG_CLOUD

GATEWAY_PUBLIC_PORT=18080
WEB_PUBLIC_PORT=18081
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:18081,http://127.0.0.1:18081
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

SENTINEL_DASHBOARD_PORT=8858
ELASTICSEARCH_PORT=9200
ZIPKIN_PORT=9411
PROMETHEUS_PORT=9090
GRAFANA_PORT=13000
